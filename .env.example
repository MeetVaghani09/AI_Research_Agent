# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Tavily
# Required for "web" and "both" routes.
TAVILY_API_KEY=

# Qdrant
# Local development:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ResearchDocuments

# LangSmith
# Optional - tracing and observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Redis
# Leave empty to use in-memory conversation history.
# For Redis Cloud, put the complete connection URL here.
REDIS_URL=

# Application
DEFAULT_SESSION_ID=research-user