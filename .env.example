# DeepSeek
DEEPSEEK_API_KEY=
# DeepSeek retired the old "deepseek-chat"/"deepseek-reasoner" aliases.
# Set the current model id here so you never have to touch code again.
DEEPSEEK_MODEL=deepseek-v4-flash

# Tavily (web search) - required for "web" and "both" routes
TAVILY_API_KEY=

# Qdrant - defaults to a local instance at http://localhost:6333
# For Qdrant Cloud, set QDRANT_URL to your cluster URL and QDRANT_API_KEY.
# For a local/self-hosted Qdrant with no auth, leave QDRANT_API_KEY empty.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=research_documents

# LangSmith (optional - tracing/observability)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Redis is optional. If empty, the app uses in-memory conversation history
# (history resets when the app restarts).
REDIS_URL=

DEFAULT_SESSION_ID=research-user
